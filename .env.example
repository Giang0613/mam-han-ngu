# Optional services. Server-only values; never prefix secrets with NEXT_PUBLIC.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# Exact public origin behind HTTPS/reverse proxy, e.g. https://learn.example.
# Without this, direct request origin checking is used.
APP_ORIGIN=
# Set to 1 only when a proxy replaces X-Forwarded-For with ONE verified IP.
TRUST_PROXY=
# Instance-wide daily request caps default to 30 tutor / 20 speech.
# 0 disables the service. Empty uses the default.
AI_INSTANCE_DAILY_LIMIT=
SPEECH_INSTANCE_DAILY_LIMIT=
AI_IP_DAILY_LIMIT=
SPEECH_IP_DAILY_LIMIT=
# Optional absolute paths for persistent server-local storage.
STUDY_DATABASE_PATH=
STUDY_BACKUP_DIR=
SUPERWEB_AUDIO_ROOT=
SUPERWEB_AUDIO_PYTHON=
