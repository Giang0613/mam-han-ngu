# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local learner data and alternate production build
/local.db
/local.db-wal
/local.db-shm
/.next-production/
!.env.example
/.cache/

# Local Python tooling and release exports
__pycache__/
*.py[cod]
/releases/
/data/i18n-private.en.json
/data/i18n-private-overrides.en.json

# Local learner data and recordings
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/recordings/

# Container learner data must never be published.
/storage/
