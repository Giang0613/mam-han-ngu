{"id":"workbook-028","book":"workbook","page":28,"image":"/hsk1-materials/pages/workbook/028.webp","width":1190,"height":1684,"lines":[{"id":"workbook-028-0","text":"我有两个孩子 Lesson 4","zh":"我有两个孩子4","pinyin":"wǒ yǒu liǎng gè hái zi 4","vi":"Tôi có hai người con","translation":"edited","confidence":0.935},{"id":"workbook-028-3","text":"男：你们好吗？","zh":"男：你们好吗？","pinyin":"nán： nǐ men hǎo ma？","vi":"Chào các chàng trai.","translation":"machine","confidence":0.93383},{"id":"workbook-028-6","text":"女：很好，我们很（","zh":"女：很好，我们很","pinyin":"nǚ： hěn hǎo， wǒ men hěn","vi":"Chúng tôi ổn.","translation":"machine","confidence":0.99822},{"id":"workbook-028-7","text":"）你。","zh":"你","pinyin":"nǐ","vi":"Bạn, anh, chị","translation":"edited","confidence":0.99629},{"id":"workbook-028-8","text":"第四部分Part IV","zh":"第四部分","pinyin":"dì sì bù fen","vi":"Phần 4","translation":"machine","confidence":0.98102},{"id":"workbook-028-9","text":"第19—20题：选择正确答案。","zh":"第1920题：选择正确答案","pinyin":"dì 1 9 2 0 tí： xuǎn zé zhèng què dá àn","vi":"Câu trả lời là đúng.","translation":"machine","confidence":0.98894},{"id":"workbook-028-12","text":"例如：请问现在几点了？","zh":"例如：请问现在几点了？","pinyin":"lì rú： qǐng wèn xiàn zài jǐ diǎn le？","vi":"Mấy giờ rồi?","translation":"machine","confidence":0.96613},{"id":"workbook-028-15","text":"★说话人","zh":"说话人","pinyin":"shuō huà rén","vi":"Nói chuyện với ai đó đi.","translation":"machine","confidence":0.99714},{"id":"workbook-028-16","text":"想知道什么？","zh":"想知道什么？","pinyin":"xiǎng zhī dào shén me？","vi":"Anh muốn biết gì?","translation":"machine","confidence":0.96395},{"id":"workbook-028-21","text":"A时间","zh":"时间","pinyin":"shíjiān","vi":"Thời gian","translation":"edited","confidence":0.99985},{"id":"workbook-028-22","text":"B名字","zh":"名字","pinyin":"míngzi","vi":"Tên gọi","translation":"edited","confidence":0.99518},{"id":"workbook-028-23","text":"C房间号","zh":"房间号","pinyin":"fáng jiān hào","vi":"Số phòng?","translation":"machine","confidence":0.99969},{"id":"workbook-028-29","text":"我家有三口人，爸爸、妈妈和我。","zh":"我家有三口人，爸爸、妈妈和我","pinyin":"wǒ jiā yǒu sān kǒu rén， bà ba、 mā ma hé wǒ","vi":"Tôi có ba người. Cha, mẹ tôi và tôi.","translation":"machine","confidence":0.99788},{"id":"workbook-028-31","text":"★说话人家里有：","zh":"说话人家里有：","pinyin":"shuō huà rén jiā lǐ yǒu：","vi":"Có một người đàn ông nói chuyện:","translation":"machine","confidence":0.99834},{"id":"workbook-028-35","text":"A女","zh":"女","pinyin":"nǚ","vi":"Nữ, con gái","translation":"edited","confidence":0.78825},{"id":"workbook-028-36","text":"姐姐","zh":"姐姐","pinyin":"jiějie","vi":"Chị gái","translation":"edited","confidence":0.99923},{"id":"workbook-028-37","text":"B三口人","zh":"三口人","pinyin":"sān kǒu rén","vi":"3 người.","translation":"machine","confidence":0.99935},{"id":"workbook-028-38","text":"C四口人","zh":"四口人","pinyin":"sì kǒu rén","vi":"Tứ khẩu.","translation":"machine","confidence":0.9961},{"id":"workbook-028-41","text":"她是法国人，我不是。","zh":"她是法国人，我不是","pinyin":"tā shì fǎ guó rén， wǒ bù shì","vi":"Cô ấy là người Pháp, không phải tôi.","translation":"machine","confidence":0.99984},{"id":"workbook-028-43","text":"★“她”是：","zh":"“她”是：","pinyin":"tā” shì：","vi":"Và cô ta là:","translation":"machine","confidence":0.96979},{"id":"workbook-028-47","text":"A法国人","zh":"法国人","pinyin":"fǎ guó rén","vi":"Người Pháp.","translation":"machine","confidence":0.99979},{"id":"workbook-028-48","text":"B中国人","zh":"中国人","pinyin":"zhōng guó rén","vi":"Trung Quốc.","translation":"machine","confidence":0.99973},{"id":"workbook-028-49","text":"C泰国人","zh":"泰国人","pinyin":"tài guó rén","vi":"Thái Lan.","translation":"machine","confidence":0.99697}],"audioTracks":[]}