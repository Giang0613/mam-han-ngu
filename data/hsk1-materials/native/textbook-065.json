ed","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99316,"label":"2","responseKey":"native-textbook-065-25","role":"example"},{"id":"textbook-065-26","text":"（3）李文晚上还有事呢。","zh":"李文晚上还有事呢。","pinyin":"lǐ wén wǎn shàng hái yǒu shì ne。","vi":"Lý Văn tối nay vẫn còn có việc đấy.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99847,"label":"3","responseKey":"native-textbook-065-26","role":"example"}],"responseKey":"native-textbook-065-block-1"},{"id":"textbook-065-block-2","title":"Hội thoại 3","kind":"dialogue","items":[{"id":"textbook-065-29","text":"王一雪在办公室给刘明打电话。WangYixuewascallingLiuMingattheoffice.","zh":"王一雪在办公室给刘明打电话。","pinyin":"wáng yī xuě zài bàn gōng shì gěi liú míng dǎ diàn huà。","vi":"Vương Nhất Tuyết gọi điện cho Lưu Minh từ văn phòng.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.97616,"role":"example"}]},{"id":"textbook-065-block-3","title":"Nghe đoạn hội thoại hai lần và chọn đáp án đúng.","kind":"exercise","items":[{"id":"textbook-065-30","text":"听两遍对话，选择正确答案。Listen to thedialogue twice andchoose thecorrect answer.)7-5","zh":"听两遍对话，选择正确答案。","pinyin":"tīng liǎng biàn duì huà， xuǎn zé zhèng què dá àn。","vi":"Nghe đoạn hội thoại hai lần và chọn đáp án đúng.","translation":"edited","confidence":0.96178,"role":"instruction"},{"id":"textbook-065-33","text":"（1）刘明（","zh":"刘明＿＿＿呢。","pinyin":"liú míng · ne。","vi":"Lưu Minh Thế, nhỉ, ư","translation":"edited","confidence":0.9911,"label":"1","role":"example","responseKey":"native-textbook-065-33","mergedIds":["textbook-065-34"]},{"id":"textbook-065-38","text":"A上班","zh":"上班","pinyin":"shàng bān","vi":"Đi làm","translation":"edited","confidence":0.99988,"label":"A","role":"example"},{"id":"textbook-065-39","text":"B买菜","zh":"买菜","pinyin":"mǎi cài","vi":"Mua rau; mua thực phẩm để nấu ăn.","translation":"edited","confidence":0.98857,"label":"B","role":"example"},{"id":"textbook-065-40","text":"C在家里","zh":"在家里","pinyin":"zà