{"id":"textbook-027","book":"textbook","page":27,"title":"Hội thoại","blocks":[{"id":"textbook-027-block-0","title":"Hội thoại","kind":"dialogue","items":[{"id":"textbook-027-2","text":"大声朗读。Read aloud.","zh":"大声朗读。","pinyin":"dà shēng lǎng dú。","vi":"Đọc to thành tiếng.","translation":"edited","confidence":0.97194,"role":"instruction"},{"id":"textbook-027-3","text":"（1）我老师","zh":"我老师","pinyin":"wǒ lǎo shī","vi":"Giáo viên của tôi.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99969,"label":"1","role":"example"},{"id":"textbook-027-4","text":"（2）我学生","zh":"我学生","pinyin":"wǒ xué sheng","vi":"Học sinh của tôi.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99593,"label":"2","role":"example"},{"id":"textbook-027-5","text":"（3）你同学","zh":"你同学","pinyin":"nǐ tóng xué","vi":"Bạn học của bạn.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99927,"label":"3","role":"example"},{"id":"textbook-027-6","text":"（4）我妈妈（mama,mother）","zh":"我妈妈","pinyin":"wǒ mā ma","vi":"Mẹ của tôi.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99654,"label":"4","role":"example"}]},{"id":"textbook-027-block-1","title":"Hoàn thành đoạn hội thoại.","kind":"exercise","items":[{"id":"textbook-027-7","text":"完成对话。Completethedialogues.","zh":"完成对话。","pinyin":"wán chéng duì huà。","vi":"Hoàn thành đoạn hội thoại.","translation":"edited","confidence":0.99862,"role":"example"},{"id":"textbook-027-8","text":"（1）A：这是我（","zh":"：这是我＿＿＿","pinyin":"zhè shì wǒ","vi":"A: Đây là … của tôi.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99615,"label":"1","responseKey":"native-textbook-027-8","role":"example"},{"id":"textbook-027-10","text":"B：老师，您好！","zh":"：老师，您好！","pinyin":"lǎo shī， nín hǎo！","vi":"Em chào thầy/cô","translation":"edited","confidence":0.96306,"label":"B","role":"example"},{"id":"textbook-027-11","text":"（2）李文：请问，你（","zh":"李文：请问，你＿＿＿叫什么名字？","pinyin":"lǐ wén： qǐng wèn， nǐ · jiào shén me míng zi？","vi":"Lý Văn: Xin hỏi, … của bạn tên là gì?","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99655,"label":"2","responseKey":"native-textbook-027-11","role":"example","mergedIds":["textbook-027-12"]},{"id":"textbook-027-13","text":"白家月：我（","zh":"白家月：我＿＿＿叫王一飞。","pinyin":"bái jiā yuè： wǒ · jiào wáng yī fēi。","vi":"Bạch Gia Nguyệt: … của tôi tên là Vương Nhất Phi.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.9892,"role":"example","responseKey":"native-textbook-027-13","mergedIds":["textbook-027-14"]}],"responseKey":"native-textbook-027-block-1"},{"id":"textbook-027-block-2","title":"Hội thoại 2","kind":"dialogue","items":[{"id":"textbook-027-17","text":"在教室里，下课后，安妮在看陈天中手机里的照片。Afterclass，Anniewaslookingatthe","zh":"在教室里，下课后，安妮在看陈天中手机里的照片。","pinyin":"zài jiào shì lǐ， xià kè hòu， ān nī zài kàn chén tiān zhōng shǒu jī lǐ de zhào piàn。","vi":"Sau giờ học trong lớp, Annie xem những bức ảnh trên điện thoại của Trần Thiên Trung.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99648,"role":"instruction"},{"id":"textbook-027-19","text":"朗读对话。Readthedialoguealoud.)3-3","zh":"朗读对话。","pinyin":"lǎng dú duì huà。","vi":"Đọc thành tiếng đoạn hội thoại.","translation":"edited","confidence":0.97945,"role":"instruction"},{"id":"textbook-027-20","text":"“谁”也可以读成“shui”","zh":"“谁”也可以读成“shuí”。","pinyin":"shuí” yě kě yǐ dú chéng“","vi":"谁 có hai cách đọc thông dụng: shéi và shuí; đều có nghĩa là “ai”.","translation":"edited","confidence":0.95017,"reviewed":true,"role":"example"}]},{"id":"textbook-027-block-3","title":"Ghi nhớ","kind":"reading","items":[{"id":"textbook-027-24","text":"“谁”can also be pronounced as“shui”","zh":"“谁”“”","pinyin":"shéi","vi":"Ai","translation":"edited","confidence":0.94761,"role":"example"},{"id":"textbook-027-25","text":"这是谁？","zh":"这是谁？","pinyin":"zhè shì shuí？","vi":"Đây là ai?","translation":"edited","confidence":0.87991,"speaker":"安妮","speakerPinyin":"ān nī","role":"utterance"},{"id":"textbook-027-29","text":"这是我女朋友。","zh":"这是我女朋友。","pinyin":"zhè shì wǒ nǚ péng you。","vi":"Đây là bạn gái của tôi.","translation":"edited","confidence":0.99905,"speaker":"陈天中","speakerPinyin":"chén tiān zhōng","role":"utterance"},{"id":"textbook-027-33","text":"你女朋友是哪国人?","zh":"你女朋友是哪国人？","pinyin":"nǐ nǚ péng you shì nǎ guó rén？","vi":"Bạn gái của bạn là người nước nào?","translation":"edited","confidence":0.96319,"speaker":"安妮","speakerPinyin":"ān nī","role":"utterance"},{"id":"textbook-027-39","text":"她也是泰国人。","zh":"她也是泰国人。","pinyin":"tā yě shì tài guó rén。","vi":"Cô ấy cũng là người Thái Lan.","translation":"edited","confidence":0.99938,"speaker":"陈天中","speakerPinyin":"chén tiān zhōng","role":"utterance"}]}],"audioTracks":[3]}