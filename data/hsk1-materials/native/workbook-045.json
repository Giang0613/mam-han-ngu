{"id":"workbook-045","book":"workbook","page":45,"title":"Câu 19–20: chọn đáp án đúng.","blocks":[{"id":"workbook-045-block-0","title":"Nội dung bài học","kind":"reading","items":[{"id":"workbook-045-4","text":"男：我的手机号是+8613552721160。","zh":"男：我的手机号是+8613552721160。","pinyin":"nán： wǒ de shǒu jī hào shì","vi":"Nam: Số điện thoại di động của tôi là +8613552721160.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99947,"role":"example"},{"id":"workbook-045-7","text":"女：我（","zh":"女：我＿＿＿","pinyin":"nǚ： wǒ","vi":"Nữ: Tôi …","translation":"edited","confidence":0.99846,"role":"example"},{"id":"workbook-045-8","text":"）你的手机号，你的电话号呢?","zh":"你的手机号，你的电话号呢？","pinyin":"nǐ de shǒu jī hào， nǐ de diàn huà hào ne？","vi":"…số điện thoại di động của bạn; còn số điện thoại bàn thì sao?","translation":"edited","confidence":0.98418,"role":"example"}]},{"id":"workbook-045-block-2","title":"Câu 19–20: chọn đáp án đúng.","kind":"exercise","items":[{"id":"workbook-045-10","text":"第19—20题：选择正确答案。","zh":"第19–20题：选择正确答案","pinyin":"dì 1 9 · 2 0 tí： xuǎn zé zhèng què dá àn","vi":"Câu 19–20: chọn đáp án đúng.","translation":"edited","confidence":0.96174,"role":"instruction"},{"id":"workbook-045-13","text":"例如：请问现在几点了？","zh":"例如：请问现在几点了？","pinyin":"lì rú： qǐng wèn xiàn zài jǐ diǎn le？","vi":"Ví dụ: Xin hỏi, bây giờ là mấy giờ?","translation":"edited","confidence":0.98938,"role":"example"},{"id":"workbook-045-16","text":"★说话人想知道什么？","zh":"说话人想知道什么？","pinyin":"shuō huà rén xiǎng zhī dào shén me？","vi":"Người nói muốn biết điều gì?","translation":"edited","confidence":0.9468,"role":"example"},{"id":"workbook-045-21","text":"A时间","zh":"时间","pinyin":"shíjiān","vi":"Thời gian","translation":"edited","confidence":0.99993,"label":"A","role":"example"},{"id":"workbook-045-22","text":"B名字","zh":"名字","pinyin":"míngzi","vi":"Tên gọi","translation":"edited","confidence":0.99918,"label":"B","role":"example"},{"id":"workbook-045-23","text":"C房间号","zh":"房间号","pinyin":"fáng jiān