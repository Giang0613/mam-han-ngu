xt":"B牛奶","zh":"牛奶","pinyin":"niú nǎi","vi":"Sữa bò","translation":"edited","confidence":0.99968,"label":"B","role":"example"},{"id":"workbook-045-50","text":"C饺子","zh":"饺子","pinyin":"jiǎo zi","vi":"Sủi cảo","translation":"edited","confidence":0.996,"label":"C","role":"example"}],"responseKey":"native-workbook-045-block-2"}],"audioTracks":[]}