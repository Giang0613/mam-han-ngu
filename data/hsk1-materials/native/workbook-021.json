{"id":"workbook-021","book":"workbook","page":21,"title":"Đọc và luyện phát âm","blocks":[{"id":"workbook-021-edited-0","title":"Đọc và luyện phát âm","kind":"vocabulary","items":[{"id":"workbook-021-edited-0-item-0","text":"你好","zh":"你好","pinyin":"nǐ hǎo","vi":"Xin chào","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-0-item-1","text":"哪里","zh":"哪里","pinyin":"nǎlǐ","vi":"Ở đâu","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-0-item-2","text":"小语","zh":"小语","pinyin":"xiǎo yǔ","vi":"Tiểu Ngữ","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-0-item-3","text":"水果","zh":"水果","pinyin":"shuǐ guǒ","vi":"Trái cây","translation":"edited","confidence":1,"reviewed":true,"role":"word"}]},{"id":"workbook-021-edited-1","title":"Thanh nhẹ","kind":"phonetics","items":[{"id":"workbook-021-edited-1-item-0","text":"轻声是又轻又短的声调。轻声音节不标声调。","zh":"轻声是又轻又短的声调。轻声音节不标声调。","pinyin":"qīng shēng shì yòu qīng yòu duǎn de shēng diào。 qīng shēng yīn jié bù biāo shēng diào。","vi":"Thanh nhẹ được đọc nhẹ và ngắn; âm tiết thanh nhẹ không ghi dấu thanh.","translation":"edited","confidence":1,"reviewed":true,"role":"example"},{"id":"workbook-021-edited-1-item-1","text":"有的词，读轻声和不读轻声，意义有所不同。","zh":"有的词，读轻声和不读轻声，意义有所不同。","pinyin":"yǒu de cí， dú qīng shēng hé bù dú qīng shēng， yì yì yǒu suǒ bù tóng。","vi":"Một số từ đổi nghĩa khi âm tiết cuối chuyển thành thanh nhẹ.","translation":"edited","confidence":1,"reviewed":true,"role":"example"}]},{"id":"workbook-021-edited-2","title":"Phân biệt nghĩa","kind":"phonetics","items":[],"table":{"columns":["Chữ","Không đọc nhẹ","Nghĩa","Đọc nhẹ","Nghĩa"],"rows":[["东西","dōng xī","Đông và tây","dōng xi","Đồ vật"],["买卖","mǎi mài","Mua và bán","mǎi mai","Việc kinh doanh"],["孙子","Sūn zǐ","Tôn Tử (tên riêng)","sūn zi","Cháu trai"]],"readings":[["dōngxi","","","",""],["mǎi mài","","","",""],["sūn zi","","","",""]]}},{"id":"workbook-021-edited-3","title":"Đọc và luyện phát âm","kind":"vocabulary","items":[{"id":"workbook-021-edited-3-item-0","text":"妈妈","zh":"妈妈","pinyin":"māma","vi":"Mẹ","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-3-item-1","text":"爸爸","zh":"爸爸","pinyin":"bàba","vi":"Bố","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-3-item-2","text":"椅子","zh":"椅子","pinyin":"yǐ zi","vi":"Ghế","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"workbook-021-edited-3-item-3","text":"饺子","zh":"饺子","pinyin":"jiǎo zi","vi":"Bánh chẻo; bánh có vỏ bột và nhân, thường luộc hoặc hấp.","translation":"edited","confidence":1,"reviewed":true,"role":"word"}]}],"audioTracks":[]}