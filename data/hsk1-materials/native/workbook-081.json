us-zh-vi-sentences-names-v2","confidence":0.95459,"role":"example"},{"id":"workbook-081-29","text":"A杯子","zh":"杯子","pinyin":"bēi zi","vi":"Ly; cốc; tách","translation":"edited","confidence":0.99912,"label":"A","role":"example"},{"id":"workbook-081-30","text":"B手机","zh":"手机","pinyin":"shǒu jī","vi":"Điện thoại di động","translation":"edited","confidence":0.99983,"label":"B","role":"example"},{"id":"workbook-081-31","text":"C水果","zh":"水果","pinyin":"shuǐ guǒ","vi":"Trái cây","translation":"edited","confidence":0.9979,"label":"C","role":"example"},{"id":"workbook-081-34","text":"这件衣服很好看，你也能穿，买一件吧。","zh":"这件衣服很好看，你也能穿，买一件吧。","pinyin":"zhè jiàn yī fu hěn hǎo kàn， nǐ yě néng chuān， mǎi yī jiàn ba。","vi":"Chiếc áo này rất đẹp; bạn cũng mặc được, mua một chiếc nhé.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99941,"role":"example"},{"id":"workbook-081-36","text":"★那件衣服：","zh":"那件衣服：","pinyin":"nà jiàn yī fu：","vi":"Chiếc áo đó: …","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99518,"role":"example"},{"id":"workbook-081-40","text":"A好看","zh":"好看","pinyin":"hǎo kàn","vi":"Đẹp; hay; thú vị","translation":"edited","confidence":0.99968,"label":"A","role":"example"},{"id":"workbook-081-41","text":"B便宜","zh":"便宜","pinyin":"pián yi","vi":"Rẻ","translation":"edited","confidence":0.99977,"label":"B","role":"example"},{"id":"workbook-081-42","text":"C很贵","zh":"很贵","pinyin":"hěn guì","vi":"Rất đắt.","translation":"edited","confidence":0.99878,"label":"C","role":"example"}],"responseKey":"native-workbook-081-block-1"}],"audioTracks":[]}