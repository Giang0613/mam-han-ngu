n":"yáng tóng lè","vi":"Dương Đồng Lạc","translation":"edited","confidence":0.99973,"role":"example"},{"id":"textbook-045-40","text":"你会做什么？","zh":"你会做什么？","pinyin":"nǐ huì zuò shén me？","vi":"Bạn biết nấu món gì?","translation":"edited","confidence":0.99674,"role":"example"},{"id":"textbook-045-42","text":"王一雪","zh":"王一雪","pinyin":"wáng yī xuě","vi":"Vương Nhất Tuyết","translation":"edited","confidence":0.9992,"role":"example"},{"id":"textbook-045-44","text":"我会做面条儿、","zh":"我会做面条儿、","pinyin":"wǒ huì zuò miàn tiáo ér、","vi":"Tôi biết làm mì sợi,…","translation":"edited","confidence":0.99827,"role":"example"},{"id":"textbook-045-49","text":"杨同乐","zh":"杨同乐","pinyin":"yáng tóng lè","vi":"Dương Đồng Lạc","translation":"edited","confidence":0.99986,"role":"example"},{"id":"textbook-045-50","text":"饺子，也会做","zh":"饺子，也会做","pinyin":"jiǎo zi， yě huì zuò","vi":"…bánh chẻo, và cũng biết làm…","translation":"edited","confidence":0.99968,"role":"example"},{"id":"textbook-045-54","text":"一些菜。星期天","zh":"一些菜。星期天","pinyin":"yī xiē cài。 xīng qī tiān","vi":"…một số món ăn. Vào Chủ nhật,…","translation":"edited","confidence":0.99292,"role":"example"},{"id":"textbook-045-58","text":"我也做饭。","zh":"我也做饭。","pinyin":"wǒ yě zuò fàn。","vi":"…tôi cũng nấu ăn.","translation":"edited","confidence":0.99934,"role":"example"}],"responseKey":"native-textbook-045-block-2"}],"audioTracks":[3]}