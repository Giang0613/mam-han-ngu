{"id":"workbook-108","book":"workbook","page":108,"title":"Câu 19–20: chọn đáp án đúng.","blocks":[{"id":"workbook-108-block-0","title":"Nội dung bài học","kind":"reading","items":[{"id":"workbook-108-3","text":"男：请坐，您要什么？","zh":"男：请坐，您要什么？","pinyin":"nán： qǐng zuò， nín yào shén me？","vi":"Nam: Mời chị ngồi! Chị muốn dùng gì?","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.98403,"role":"example"},{"id":"workbook-108-6","text":"女：请（","zh":"女：请＿＿＿","pinyin":"nǚ： qǐng","vi":"Nữ: Xin …","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.9954,"role":"example"},{"id":"workbook-108-7","text":"）我一杯茶。","zh":"我一杯茶。","pinyin":"wǒ yī bēi chá。","vi":"…tôi một tách trà.","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.99575,"role":"example"}]},{"id":"workbook-108-block-2","title":"Câu 19–20: chọn đáp án đúng.","kind":"exercise","items":[{"id":"workbook-108-9","text":"第19—20题：选择正确答案。","zh":"第19–20题：选择正确答案","pinyin":"dì 1 9 · 2 0 tí： xuǎn zé zhèng què dá àn","vi":"Câu 19–20: chọn đáp án đúng.","translation":"edited","confidence":0.96617,"role":"instruction"},{"id":"workbook-108-12","text":"例如：请问现在几点了？","zh":"例如：请问现在几点了？","pinyin":"lì rú： qǐng wèn xiàn zài jǐ diǎn le？","vi":"Ví dụ: Xin hỏi, bây giờ là mấy giờ?","translation":"edited","confidence":0.98835,"role":"example"},{"id":"workbook-108-15","text":"★说话人","zh":"说话人","pinyin":"shuō huà rén","vi":"Người nói…","translation":"edited","confidence":0.99794,"role":"example"},{"id":"workbook-108-16","text":"想","zh":"想","pinyin":"xiǎng","vi":"Nghĩ, muốn","translation":"edited","confidence":0.98164,"role":"example"},{"id":"workbook-108-17","text":"知道什么？","zh":"知道什么？","pinyin":"zhī dào shén me？","vi":"…biết điều gì?","translation":"edited","modelRevision":"opus-zh-vi-sentences-names-v2","confidence":0.96025,"role":"example"},{"id":"workbook-108-23","text":"时间","zh":"时间","pinyin":"shíjiān","vi":"Thời gian","translation":"edited","