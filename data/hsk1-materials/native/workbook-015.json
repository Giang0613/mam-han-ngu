-2-item-10","audio":false,"role":"example"},{"id":"workbook-015-edited-2-item-11","text":"jie","zh":"jie","pinyin":"jie","vi":"Ghi âm tiết có dấu thanh bạn nghe được.","translation":"edited","confidence":1,"reviewed":true,"label":"12","responseKey":"native-workbook-015-edited-2-item-11","audio":false,"role":"example"}],"context":"Cần bản thu bài tập tương ứng để làm phần nghe; có thể dùng phần này để tự luyện với giáo viên.","responseKey":"native-workbook-015-edited-2"},{"id":"workbook-015-edited-3","title":"Ghép tình huống với hội thoại","kind":"exercise","items":[{"id":"workbook-015-edited-3-item-0","text":"A：老师，再见！ B：再见！","zh":"A：老师，再见！ B：再见！","pinyin":"lǎo shī， zài jiàn！ · zài jiàn！","vi":"A: Thưa thầy/cô, tạm biệt! B: Tạm biệt!","translation":"edited","confidence":1,"reviewed":true,"role":"example"},{"id":"workbook-015-edited-3-item-1","text":"A：对不起。 B：没关系。","zh":"A：对不起。 B：没关系。","pinyin":"duì bù qǐ。 · méi guān xi。","vi":"A: Xin lỗi. B: Không sao.","translation":"edited","confidence":1,"reviewed":true,"role":"example"},{"id":"workbook-015-edited-3-item-2","text":"A：很高兴认识你。 B：认识你我也很高兴。","zh":"A：很高兴认识你。 B：认识你我也很高兴。","pinyin":"hěn gāo xìng rèn shi nǐ。 · rèn shi nǐ wǒ yě hěn gāo xìng。","vi":"A: Rất vui được quen bạn. B: Tôi cũng rất vui được quen bạn.","translation":"edited","confidence":1,"reviewed":true,"role":"example"},{"id":"workbook-015-edited-3-item-3","text":"A：大家好，我叫白家月。 B：白家月，你好。","zh":"A：大家好，我叫白家月。 B：白家月，你好。","pinyin":"dà jiā hǎo， wǒ jiào bái jiā yuè。 · bái jiā yuè， nǐ hǎo。","vi":"A: Chào mọi người, tôi tên Bạch Gia Nguyệt. B: Chào Bạch Gia Nguyệt.","translation":"edited","confidence":1,"reviewed":true,"role":"example"}],"context":"1. Hai người bắt tay khi gặp nhau. 2. Giáo viên vẫy chào hai học sinh. 3. Một học sinh đứng giới thiệu tên. 4. Một người xin lỗi người đang nghe mình nói. Ghi số hội thoại phù hợp.","responseKey":"native-workbook-015-edited-3"}],"audioTracks":[]}