{"id":"textbook-017","book":"textbook","page":17,"title":"Hội thoại 2","blocks":[{"id":"textbook-017-edited-0","title":"Hội thoại 2","kind":"dialogue","items":[{"id":"textbook-017-edited-0-item-0","text":"开学第一天，课堂上，学生们学习打招呼用语。","zh":"开学第一天，课堂上，学生们学习打招呼用语。","pinyin":"kāi xué dì yī tiān， kè táng shàng， xué sheng men xué xí dǎ zhāo hū yòng yǔ。","vi":"Ngày đầu tiên đến lớp, các học sinh học cách chào hỏi.","translation":"edited","confidence":1,"reviewed":true,"role":"instruction"},{"id":"textbook-017-edited-0-item-1","text":"大家好！","zh":"大家好！","pinyin":"dà jiā hǎo！","vi":"Chào mọi người!","translation":"edited","confidence":1,"reviewed":true,"speaker":"王一飞","speakerPinyin":"wáng yī fēi","role":"utterance"},{"id":"textbook-017-edited-0-item-2","text":"老师，您好！","zh":"老师，您好！","pinyin":"lǎo shī， nín hǎo！","vi":"Chúng em chào cô ạ!","translation":"edited","confidence":1,"reviewed":true,"speaker":"学生们","speakerPinyin":"xué sheng men","role":"utterance"},{"id":"textbook-017-edited-0-item-3","text":"你们好！","zh":"你们好！","pinyin":"nǐ men hǎo！","vi":"Chào các bạn!","translation":"edited","confidence":1,"reviewed":true,"speaker":"小语","speakerPinyin":"xiǎo yǔ","role":"utterance"},{"id":"textbook-017-edited-0-item-4","text":"你好，小语！","zh":"你好，小语！","pinyin":"nǐ hǎo， xiǎo yǔ！","vi":"Chào Tiểu Ngữ!","translation":"edited","confidence":1,"reviewed":true,"speaker":"学生们","speakerPinyin":"xué sheng men","role":"utterance"}]},{"id":"textbook-017-edited-1","title":"Xưng hô kính trọng","kind":"grammar","items":[{"id":"textbook-017-edited-1-item-0","text":"“您”是敬称，对年长者或尊敬的人使用。","zh":"“您”是敬称，对年长者或尊敬的人使用。","pinyin":"nín” shì jìng chēng， duì nián zhǎng zhě huò zūn jìng de rén shǐ yòng。","vi":"您 là cách gọi kính trọng, dùng với người lớn tuổi hoặc người bạn muốn thể hiện sự tôn trọng.","translation":"edited","confidence":1,"reviewed":true,"role":"example"}]},{"id":"textbook-017-edited-2","title":"Đọc to từng từ","kind":"vocabulary","items":[{"id":"textbook-017-edited-2-item-0","text":"大家","zh":"大家","pinyin":"dàjiā","vi":"Mọi người","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-1","text":"好","zh":"好","pinyin":"hǎo","vi":"Tốt; khỏe","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-2","text":"学生","zh":"学生","pinyin":"xuésheng","vi":"Học sinh; người đang học.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-3","text":"们","zh":"们","pinyin":"men","vi":"Hậu tố số nhiều chỉ người","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-4","text":"老师","zh":"老师","pinyin":"lǎoshī","vi":"Giáo viên; thầy, cô.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-5","text":"您","zh":"您","pinyin":"nín","vi":"Ông; bà; thầy/cô (cách gọi kính trọng)","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-017-edited-2-item-6","text":"你们","zh":"你们","pinyin":"nǐ men","vi":"Các bạn","translation":"edited","confidence":1,"reviewed":true,"role":"word"}]},{"id":"textbook-017-edited-3","title":"Luyện theo vai","kind":"exercise","items":[{"id":"textbook-017-edited-3-item-0","text":"分角色朗读对话。","zh":"分角色朗读对话。","pinyin":"fēn jué sè lǎng dú duì huà。","vi":"Phân vai và đọc thành tiếng đoạn hội thoại.","translation":"edited","confidence":1,"reviewed":true,"role":"instruction","practiceMode":"with-others"},{"id":"textbook-017-edited-3-item-1","text":"两人一组或多人一组，用真实姓名对话。","zh":"两人一组或多人一组，用真实姓名对话。","pinyin":"liǎng rén yī zǔ huò duō rén yī zǔ， yòng zhēn shí xìng míng duì huà。","vi":"Làm việc theo cặp hoặc nhóm; dùng tên thật để chào hỏi theo mẫu.","translation":"edited","confidence":1,"reviewed":true,"role":"instruction","practiceMode":"with-others"}],"practiceMode":"with-others","retiredResponseKeys":["native-textbook-017-edited-3"]}],"audioTracks":[3,4]}