{"id":"textbook-066","book":"textbook","page":66,"title":"Hội thoại 3 · Việc làm buổi tối","blocks":[{"id":"textbook-066-edited-0","title":"Hội thoại 3 · Việc làm buổi tối","kind":"dialogue","items":[{"id":"textbook-066-4","text":"喂，你在哪儿呢？","zh":"喂，你在哪儿呢？","pinyin":"wéi，nǐ zài nǎr ne？","vi":"A lô, anh đang ở đâu đấy?","translation":"edited","confidence":1,"reviewed":true,"speaker":"王一雪","role":"utterance","speakerPinyin":"wáng yī xuě"},{"id":"textbook-066-14","text":"我在家里呢。","zh":"我在家里呢。","pinyin":"wǒ zài jiā li ne。","vi":"Anh đang ở nhà.","translation":"edited","confidence":1,"reviewed":true,"speaker":"刘明","role":"utterance","speakerPinyin":"liú míng"},{"id":"textbook-066-21","text":"我晚上六点半下班。","zh":"我晚上六点半下班。","pinyin":"wǒ wǎn shàng liù diǎn bàn xià bān。","vi":"Em tan làm lúc sáu giờ rưỡi tối.","translation":"edited","confidence":1,"reviewed":true,"speaker":"王一雪","role":"utterance","speakerPinyin":"wáng yī xuě"},{"id":"textbook-066-25","text":"我八点去医院上班。","zh":"我八点去医院上班。","pinyin":"wǒ bā diǎn qù yī yuàn shàng bān。","vi":"Tám giờ anh đến bệnh viện làm việc.","translation":"edited","confidence":1,"reviewed":true,"speaker":"刘明","role":"utterance","speakerPinyin":"liú míng"},{"id":"textbook-066-30","text":"好的，你去店里买些菜吧。","zh":"好的，你去店里买些菜吧。","pinyin":"hǎo de，nǐ qù diàn li mǎi xiē cài ba。","vi":"Được, anh đến cửa hàng mua một ít rau nhé.","translation":"edited","confidence":1,"reviewed":true,"speaker":"王一雪","role":"utterance","speakerPinyin":"wáng yī xuě"},{"id":"textbook-066-38","text":"好，我十分钟后去。","zh":"好，我十分钟后去。","pinyin":"hǎo， wǒ shí fēn zhōng hòu qù。","vi":"Được, mười phút nữa anh đi.","translation":"edited","confidence":1,"reviewed":true,"speaker":"刘明","role":"utterance","speakerPinyin":"liú míng"}]},{"id":"textbook-066-edited-1","title":"Cách đọc 里","kind":"grammar","items":[{"id":"textbook-066-edited-1-item-0","text":"“里”作方位词时，在“家、超市”等名词性词语后，一般读轻声“li”；在“里边”等词语中，需读第三声“lǐ”。","zh":"“里”作方位词时，在“家、超市”等名词性词语后，一般读轻声“li”；在“里边”等词语中，需读第三声“lǐ”。","pinyin":"lǐ” zuò fāng wèi cí shí， zài“ jiā、 chāo shì” děng míng cí xìng cí yǔ hòu， yī bān dú qīng shēng“ · zài“ lǐ biān” děng cí yǔ zhōng， xū dú dì sān shēng“","vi":"里 thường đọc thanh nhẹ li khi đứng sau danh từ chỉ nơi chốn như 家, 超市. Trong từ 里边, 里 đọc thanh 3 lǐ.","translation":"edited","confidence":1,"reviewed":true,"role":"explanation"}]},{"id":"textbook-066-edited-2","title":"Từ mới","kind":"vocabulary","items":[{"id":"textbook-066-edited-2-item-0","text":"在","zh":"在","pinyin":"zài","vi":"Ở, tại; đặt trước địa điểm hoặc trước động từ tùy cấu trúc.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-1","text":"家","zh":"家","pinyin":"jiā","vi":"Nhà.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-2","text":"里","zh":"里","pinyin":"li","vi":"Trong, bên trong; sau danh từ nơi chốn thường đọc li.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-3","text":"晚上","zh":"晚上","pinyin":"wǎn shàng","vi":"Buổi tối.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-4","text":"医院","zh":"医院","pinyin":"yī yuàn","vi":"Bệnh viện.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-5","text":"上班","zh":"上班","pinyin":"shàng bān","vi":"Đi làm; làm việc.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-6","text":"店","zh":"店","pinyin":"diàn","vi":"Cửa hàng.","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-7","text":"菜","zh":"菜","pinyin":"cài","vi":"Rau (trong 买些菜).","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-8","text":"分钟","zh":"分钟","pinyin":"fēnzhōng","vi":"Phút (đơn vị thời lượng).","translation":"edited","confidence":1,"reviewed":true,"role":"word"},{"id":"textbook-066-edited-2-item-9","text":"后","zh":"后","pinyin":"hòu","vi":"Sau; về sau (trong 十分钟后: mười phút nữa).","translation":"edited","confidence":1,"reviewed":true,"role":"word"}]},{"id":"textbook-066-edited-3","title":"Thực hành theo hội thoại","kind":"exercise","items":[{"id":"textbook-066-edited-3-item-0","text":"分角色朗读对话。","zh":"分角色朗读对话。","pinyin":"fēn jué sè lǎng dú duì huà。","vi":"Phân vai và đọc thành tiếng đoạn hội thoại.","translation":"edited","confidence":1,"reviewed":true,"label":"1","role":"instruction","practiceMode":"with-others"},{"id":"textbook-066-edited-3-item-1","text":"刘明晚上还去做什么？","zh":"刘明晚上还去做什么？","pinyin":"liú míng wǎn shàng hái qù zuò shén me？","vi":"Tối nay Lưu Minh còn đi làm việc gì?","translation":"edited","confidence":1,"reviewed":true,"label":"2","role":"example"}],"responseKey":"native-textbook-066-edited-3"}],"audioTracks":[5,6]}