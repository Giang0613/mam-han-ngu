4026], [0.16555, 0.33907]]}, {"text": "k、h”不和韵母“”相拼。", "confidence": 0.99289, "box": [[0.16891, 0.34442], [0.39244, 0.34442], [0.39244, 0.36045], [0.16891, 0.36045]]}, {"text": "韵母“er”不和任何声母相拼，而是单独作为一个音节。", "confidence": 0.99815, "box": [[0.2042, 0.36639], [0.66555, 0.36698], [0.66555, 0.38242], [0.2042, 0.38183]]}, {"text": "In Chinese, initials and finals combine to form syllables, but not all initials can be paired", "confidence": 0.98273, "box": [[0.20336, 0.38895], [0.88487, 0.38895], [0.88487, 0.40618], [0.20336, 0.40618]]}, {"text": "with all finals.", "confidence": 0.98282, "box": [[0.16807, 0.41211], [0.27815, 0.41211], [0.27815, 0.42815], [0.16807, 0.42815]]}, {"text": "Among the initials listed in the table below, except for the initials “n” and “l\", no other", "confidence": 0.95647, "box": [[0.2042, 0.43468], [0.88571, 0.43468], [0.88571, 0.4519], [0.2042, 0.4519]]}, {"text": "initials can combine with the final “u” or the finals beginning with “u\". In addition, the initials", "confidence": 0.96519, "box": [[0.16555, 0.45606], [0.88571, 0.45665], [0.88571, 0.47387], [0.16555, 0.47328]]}, {"text": "\"b\", “p\", and \"f\"” do not combine with the final “e”\"; the initials “f\", “g\", \"k\", and \"h” do not", "confidence": 0.92076, "box": [[0.16639, 0.47743], [0.88571, 0.47862], [0.88571, 0.49644], [0.16639, 0.49525]]}, {"text": "combinewith the final\"i\".", "confidence": 0.90924, "box": [[0.16807, 0.50297], [0.37143, 0.50297], [0.37143, 0.51663], [0.16807, 0.51663]]}, {"text": "The final “er' does not combine with any initial and stands alone as an independent syllable.", "confidence": 0.97263, "box": [[0.20336, 0.52316], [0.88235, 0.52375], [0.88235, 0.54097], [0.20336, 0.54038]]}, {"text": "先跟读声母和韵母，再大声朗读。", "confidence": 0.99942, "box": [[0.20084, 0.55701], [0.47731, 0.55701], [0.47731, 0.57245], [0.20084, 0.57245]]}, {"text": "Listen and repeat theinitials and finals,then read aloud.", "confidence": 0.97198, "box": [[0.20084, 0.57957], [0.62521, 0.5