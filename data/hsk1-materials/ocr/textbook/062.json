nfidence": 0.95224, "box": [[0.1836, 0.81567], [0.55679, 0.81693], [0.55679, 0.83574], [0.1836, 0.83448]]}, {"text": "本课语气助词“吧”读轻声（ba），在句子末尾，表示建议、商量、劝告、请求。", "confidence": 0.99553, "box": [[0.22289, 0.84639], [0.89582, 0.84765], [0.89582, 0.86583], [0.22289, 0.86458]]}, {"text": "The modal particle 吧” in this lesson is pronounced with a neutral tone (ba) at the end of", "confidence": 0.9716, "box": [[0.22374, 0.87022], [0.90777, 0.87147], [0.90777, 0.8884], [0.22374, 0.88715]]}, {"text": "a sentence.It is used to express suggestions,consultations,advice,or requests.", "confidence": 0.96048, "box": [[0.1836, 0.89342], [0.77882, 0.89404], [0.77882, 0.90972], [0.1836, 0.90909]]}, {"text": "047", "confidence": 0.99946, "box": [[0.91375, 0.94608], [0.96243, 0.94608], [0.96243, 0.9674], [0.91375, 0.9674]]}]}